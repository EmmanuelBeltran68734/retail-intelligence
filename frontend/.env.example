# Copia este archivo como .env (en la carpeta frontend) si quieres cambiar algo.
# true = las pantallas usan datos falsos (src/api/datosFalsos.js)
# false = las pantallas llaman al backend real de FastAPI
VITE_DATOS_FALSOS=true
# Dirección del backend (solo se usa con VITE_DATOS_FALSOS=false)
VITE_API_URL=http://127.0.0.1:8000/api
